# Copy to .env for local dev. In Kubernetes, these come from a Secret/ConfigMap instead.

NODE_ENV=development
PORT=5000

# Mongo now requires authentication (Threat #11: "MongoDB has no authentication configured").
# Format: mongodb://<user>:<password>@<host>:27017/fileforge?authSource=admin
MONGODB_URI=mongodb://fileforge_app:CHANGE_ME@localhost:27017/fileforge?authSource=admin

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=2h

# Comma-separated, no trailing slash, must use https:// in production
ALLOWED_ORIGINS=https://your-domain.example.com

MAX_FILE_SIZE=52428800
MAX_USER_QUOTA_BYTES=524288000
UPLOAD_DIR=./uploads

# Leave unset to disable scanning (a warning is logged on every upload instead
# of silently skipping it). Point at a ClamAV sidecar/service in production.
CLAMAV_HOST=
CLAMAV_PORT=3310
