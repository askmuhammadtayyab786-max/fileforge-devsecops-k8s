# Copy to .env in the repo root before running `docker-compose up`.
# Generate each secret with: openssl rand -base64 32   (or -base64 48 for JWT_SECRET)

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME

MONGO_APP_USERNAME=fileforge_app
MONGO_APP_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_MIN_32_CHARS

# No trailing slash; https:// required once TLS is set up (see nginx/nginx.conf)
ALLOWED_ORIGINS=https://your-domain.example.com

# Optional — leave blank to run without malware scanning (a warning is logged instead)
CLAMAV_HOST=
CLAMAV_PORT=3310
